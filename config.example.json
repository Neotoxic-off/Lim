{
  // lim configuration: copy to ~/.config/lim/config.json (or point $LIM_CONFIG at it).
  // Comments and trailing commas are allowed. Every value below is the default.
  "options": {
    "number": true,
    "relativenumber": false,
    "signcolumn": true,
    "cursorline": false,     // false: only the line number stands out, as NvChad
    "tabstop": 4,
    "shiftwidth": 0,          // 0: use tabstop
    "expandtab": true,
    "scrolloff": 0,
    "sidescrolloff": 0,
    "ignorecase": true,
    "smartcase": true,
    "hlsearch": true,
    "autopairs": true,
    "autoindent": true,
    "mapleader": " ",
    "timeoutlen": 500,        // ms to wait for the rest of a mapping
    "showtabline": true,
    "laststatus": true,
    "winbar": false,
    "cmdheight": 0,           // 0: messages become notifications, ':' borrows the last line
    "icons": true,            // Nerd Font glyphs
    "truecolor": "auto",      // true, false or "auto"
    "highlighturl": true,
    "indentguides": true,
    "matchparen": true,
    "gitsigns": true,
    "wordhighlight": true,
    "notifications": true,
    "dashboard": true,
    "syntax": true,
    "clipboard": "unnamedplus",  // or "" to keep yanks inside lim
    "foldcolumn": true,
    "colorhighlight": true,       // #RRGGBB shown in its color
    "todocomments": true,         // TODO: FIX: HACK: NOTE: … highlighted
    // "colorscheme": "catppuccin-mocha",  // unset: the last one picked with <Leader>ft (nvchad at first)
    "iconset": "nerd",            // "nerd", "unicode" or "ascii"
    "completion": true,           // words from open buffers while typing
    "statusline_style": "rounded", // "rounded", "slanted", "arrow" or "flat" (Nerd Font icon set)
    "splash": "random",           // start screen hydra: "random" (one that fits), "classic", "braille" or "small"
    "mouse": true                 // click, drag, wheel; false keeps the terminal's own selection for copying
  },

  // astrotheme palette overrides, e.g. "ui": { "base": "#000000" }.
  "palette": {},

  // Highlight groups by Neovim name: fg, bg, bold, italic, underline, link.
  // e.g. "@comment": { "fg": "#7f848e", "italic": false }, "Visual": { "link": "Search" }
  "highlights": {},

  // Keymaps per mode ("n", "i", "v", "nv"): a key sequence, { "rhs": ..., "desc": ... }, or false to disable.
  // e.g. "i": { "jk": "<Esc>" }, "n": { "<Leader>w": { "rhs": ":w<CR>", "desc": "Save" } }
  "keymaps": {}
}
