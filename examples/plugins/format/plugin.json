// Formatters: each needs its tool on PATH. The text is replaced only when the tool succeeds.
{
  "name": "format",
  "version": "1.0.0",
  "description": "Prettier, rustfmt, black, gofmt, jq",
  "commands": {
    "Prettier": {
      "run": ["prettier", "--stdin-filepath", "${file}"],
      "windows": ["cmd", "/c", "prettier", "--stdin-filepath", "${file}"],
      "output": "replace",
      "desc": "Format JS, TS, CSS, HTML, JSON, Markdown, YAML"
    },
    "Rustfmt": { "run": ["rustfmt", "--edition", "2024", "--emit", "stdout", "--quiet"], "output": "replace", "desc": "Format Rust" },
    "Black": { "run": ["black", "--quiet", "-"], "output": "replace", "desc": "Format Python" },
    "Gofmt": { "run": ["gofmt"], "output": "replace", "desc": "Format Go" },
    "Jq": { "run": ["jq", "."], "output": "replace", "desc": "Pretty-print JSON" }
  },
  "keymaps": {
    "n": { "<Leader>lf": { "rhs": ":Prettier<CR>", "desc": "Format buffer (Prettier)" } }
  }
}
