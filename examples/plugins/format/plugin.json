// Formatters, each run on save for its own file types (and by hand with :Name). Each needs its tool on PATH;
// the text is replaced only when the tool succeeds, and the file is written even when it fails.
{
  "name": "format",
  "version": "1.1.0",
  "description": "Prettier, rustfmt, black, gofmt on save; jq by hand",
  "commands": {
    "Prettier": {
      "run": ["prettier", "--stdin-filepath", "${file}"],
      "windows": ["cmd", "/c", "prettier", "--stdin-filepath", "${file}"],
      "output": "replace",
      "on": "save",
      "files": ["js", "jsx", "ts", "tsx", "css", "scss", "html", "json", "md", "yaml", "yml"],
      "desc": "Format JS, TS, CSS, HTML, JSON, Markdown, YAML"
    },
    "Rustfmt": {
      "run": ["rustfmt", "--edition", "2024", "--emit", "stdout", "--quiet"],
      "output": "replace",
      "on": "save",
      "files": ["rs"],
      "desc": "Format Rust"
    },
    "Black": { "run": ["black", "--quiet", "-"], "output": "replace", "on": "save", "files": ["py"], "desc": "Format Python" },
    "Gofmt": { "run": ["gofmt"], "output": "replace", "on": "save", "files": ["go"], "desc": "Format Go" },
    "Jq": { "run": ["jq", "."], "output": "replace", "desc": "Pretty-print JSON" }
  },
  "keymaps": {
    "n": { "<Leader>lf": { "rhs": ":Prettier<CR>", "desc": "Format buffer (Prettier)" } }
  }
}
