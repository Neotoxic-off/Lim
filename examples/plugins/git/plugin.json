// Git on the current file, as gitsigns' line blame and stage: it acts on the saved file, so write first.
{
  "name": "git",
  "version": "1.0.0",
  "description": "Blame the line, log, diff, stage, unstage, branch, status",
  "commands": {
    "Blame": { "run": ["git", "blame", "-L", "${line},${line}", "--", "${file}"], "desc": "Who changed this line" },
    "Log": { "run": ["git", "log", "--oneline", "-5", "--", "${file}"], "desc": "Last 5 commits of this file" },
    "Diff": { "run": ["git", "diff", "--stat", "--", "${file}"], "desc": "Unstaged changes of this file" },
    "Stage": { "run": ["git", "add", "--", "${file}"], "desc": "Stage this file" },
    "Unstage": { "run": ["git", "restore", "--staged", "--", "${file}"], "desc": "Unstage this file" },
    "Branch": { "run": ["git", "branch", "--show-current"], "desc": "Current branch" },
    "Status": { "run": ["git", "status", "--short"], "desc": "Changed files" }
  },
  "keymaps": {
    "n": {
      "<Leader>gl": { "rhs": ":Blame<CR>", "desc": "Git blame line" },
      "<Leader>gL": { "rhs": ":Log<CR>", "desc": "Git log of this file" },
      "<Leader>gd": { "rhs": ":Diff<CR>", "desc": "Git diff of this file" },
      "<Leader>gs": { "rhs": ":Stage<CR>", "desc": "Git stage file" },
      "<Leader>gu": { "rhs": ":Unstage<CR>", "desc": "Git unstage file" }
    }
  }
}
