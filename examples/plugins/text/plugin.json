// Text transforms on the buffer or a range (`:'<,'>Sort`). Coreutils on Linux and macOS, text.ps1 on Windows.
{
  "name": "text",
  "version": "1.0.0",
  "description": "Sort, unique, reverse, case, trailing blanks, base64",
  "commands": {
    "Sort": {
      "run": ["sort"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "sort"],
      "output": "replace",
      "desc": "Sort lines"
    },
    "Uniq": {
      "run": ["uniq"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "uniq"],
      "output": "replace",
      "desc": "Drop repeated adjacent lines"
    },
    "Reverse": {
      "run": ["awk", "{ l[NR] = $0 } END { for (i = NR; i > 0; i--) print l[i] }"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "reverse"],
      "output": "replace",
      "desc": "Reverse the line order"
    },
    "Upper": {
      "run": ["tr", "[:lower:]", "[:upper:]"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "upper"],
      "output": "replace",
      "desc": "UPPERCASE"
    },
    "Lower": {
      "run": ["tr", "[:upper:]", "[:lower:]"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "lower"],
      "output": "replace",
      "desc": "lowercase"
    },
    "Trim": {
      "run": ["sed", "s/[[:space:]]*$//"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "trim"],
      "output": "replace",
      "desc": "Remove trailing blanks"
    },
    "B64": {
      "run": ["base64"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "b64"],
      "output": "replace",
      "desc": "Encode to base64"
    },
    "B64d": {
      "run": ["base64", "-d"],
      "windows": ["powershell", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${plugin}/text.ps1", "b64d"],
      "output": "replace",
      "desc": "Decode from base64"
    }
  }
}
